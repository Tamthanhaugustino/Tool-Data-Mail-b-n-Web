# Tool Data Mail Web — environment variables
# Copy to .env.local for local dev. NEVER commit real .env files.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only (route handlers, server actions, middleware).

# --- Auth (Phase 03 demo) ----------------------------------------------------
# Required for session cookie HMAC signing.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Min length: 16 chars. In dev a fallback is used but you MUST set a real value in production.
AUTH_SECRET=

# --- Supabase (Phase 04 — foundation, used by Phase 05+) --------------------
# These are placeholders until a Supabase project is provisioned. Apps in
# Phase 04 do not connect to Supabase yet, so leaving them blank is fine.
#
# Find these values at: Supabase Dashboard → Project Settings → API.

# Public project URL — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anonymous key — safe to expose; RLS enforces row access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
# Used by route handlers / server actions for admin writes, audit log
# inserts, Stripe webhooks, etc.
SUPABASE_SERVICE_ROLE_KEY=

# --- Keyword Discovery providers (Phase 08A) --------------------------------
# Default provider when the /discover client does not specify one.
#   mock     — no external call, no quota (default, recommended for dev).
#   serpapi  — real Google SERP via SerpAPI. Requires SERPAPI_API_KEY below.
DISCOVERY_PROVIDER=mock

# SerpAPI API key — SERVER ONLY. Used only by src/lib/discovery/serpapi-provider.ts
# which is `import "server-only"` guarded. Do NOT add NEXT_PUBLIC_ prefix.
# Sign up at https://serpapi.com to get a key. Free tier ~100 searches/month.
SERPAPI_API_KEY=

# --- Domain Scan providers (Phase 09A) --------------------------------------
# Default provider when the /scan client does not specify one.
#   mock    — no external call, no quota (default, recommended for dev).
#   hunter  — real Hunter.io Domain Search. Requires HUNTER_API_KEY below.
SCAN_PROVIDER=mock

# Hunter.io API key — SERVER ONLY. Used only by src/lib/scan/hunter-provider.ts
# which is `import "server-only"` guarded. Do NOT add NEXT_PUBLIC_ prefix.
# Sign up at https://hunter.io to get a key. Free tier 25 searches/month.
HUNTER_API_KEY=
