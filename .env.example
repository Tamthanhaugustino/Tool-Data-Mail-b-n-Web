# Tool Data Mail Web — environment variables (Phase 03)
# Copy to .env.local for local dev. NEVER commit real .env files.

# Required for session cookie HMAC signing.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Min length: 16 chars. In dev a fallback is used but you MUST set a real value in production.
AUTH_SECRET=
